---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import { site } from '../site';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const socials = site.socials.filter((s) => s.url);
---
<Base lang={lang} title={t.about}>
  <section class="intro wrap">
    <h1 class="lbl">{t.about}</h1>
    <p class="bio">{t.bio}</p>
  </section>

  <section class="reel wrap section">
    <p class="lbl">{t.reel}</p>
    <Media seed="reel" loop={site.hero.loop} poster={site.hero.poster} play="auto" label="Reel / loop" />
  </section>

  <section class="wrap">
    <p class="giant">{t.giant}</p>
  </section>

  <section class="info wrap section">
    <div class="row">
      <h2 class="lbl">{t.contact}</h2>
      <ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li></ul>
    </div>
    {site.collaborations.length > 0 && (
      <div class="row">
        <h2 class="lbl">{t.collaborations}</h2>
        <ul class="cols">{site.collaborations.map((c) => <li>{c}</li>)}</ul>
      </div>
    )}
    {site.awards.length > 0 && (
      <div class="row">
        <h2 class="lbl">{t.awards}</h2>
        <ul class="awards">{site.awards.map((a) => <li><span>{a.title}</span><small class="muted">{a.detail}</small></li>)}</ul>
      </div>
    )}
    {socials.length > 0 && (
      <div class="row">
        <h2 class="lbl">{t.elsewhere}</h2>
        <ul>{socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul>
      </div>
    )}
  </section>

  <section class="contact wrap">
    <p class="lbl">{t.letsTalk}</p>
    <a class="mail" href={`mailto:${site.email}`} data-mail>{site.email}</a>
    <button class="copy small" data-copy={site.email} data-copied={t.copied} data-select={t.selectCopy}>{t.copy}</button>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(110px, 13vw, 180px); display: grid; gap: 20px; }
  .intro h1 { margin: 0; font-weight: 400; }
  .bio { margin: 0; font-size: clamp(28px, 3.8vw, 58px); letter-spacing: -0.025em; line-height: 1.1; max-width: 30ch; }
  .reel { display: grid; gap: 16px; }
  .reel p { margin: 0; }
  .reel :global(.media) { aspect-ratio: 16 / 9; }
  .giant { margin: 0; font-size: clamp(44px, 8.5vw, 150px); letter-spacing: -0.045em; line-height: 0.98; text-wrap: balance; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 24px; padding-block: 28px; border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row h2 { margin: 0; font-weight: 400; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: clamp(18px, 1.8vw, 24px); min-width: 0; }
  ul.cols { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 24px; }
  .awards { gap: 18px; }
  .awards li { display: grid; gap: 2px; }
  .awards small { font-size: 13px; }
  a:hover { opacity: 0.6; }
  .contact { display: grid; gap: 24px; padding-bottom: clamp(80px, 11vw, 160px); }
  .contact p { margin: 0; }
  .mail { font-size: clamp(34px, 7.5vw, 124px); letter-spacing: -0.045em; line-height: 0.95; overflow-wrap: anywhere; }
  .copy { justify-self: start; border: 1px solid var(--dim); padding: 10px 18px; border-radius: 999px; transition: background 0.3s, color 0.3s; }
  .copy:hover { background: var(--fg); color: var(--bg); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; gap: 12px; }
    ul.cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
